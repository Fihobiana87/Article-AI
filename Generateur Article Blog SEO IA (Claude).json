      "parameters": {
        "jsCode": "const html = $input.first().json.html;\nconst strategie = $('Parser Strategie').first().json.strategie;\nconst inputs = $('Normaliser Inputs').first().json;\nconst system = 'Tu es un expert SEO technique specialise dans les metadonnees et donnees structurees.';\nconst user = `A partir de cet article HTML, genere un JSON strict avec les cles: `+\n  'seo_title, meta_description, slug, excerpt, canonical, robots, focus_keyword, '+\n  'secondary_keywords, tags, categorie, og_title, og_description, twitter_title, '+\n  'twitter_description, reading_time, breadcrumb, json_ld_article, json_ld_faq, '+\n  'speakable_schema, alt_images.\\n\\n'+\n  `Categorie: ${inputs.categorie}\\nMot-cle principal: ${inputs.mot_cle}\\n\\n`+\n  `Article: ${html.slice(0,10000)}\\n\\nStrategie: ${JSON.stringify(strategie)}\\n\\n`+\n  'Reponds uniquement en JSON valide.';\nreturn [{ json: { system, user_prompt: user, model: inputs.claude_model } }];"
      },
