        "jsCode": "const html = $('Extraire HTML Article').first().json.html;\nconst metadata = $input.first().json.image_prompts !== undefined ? $('Parser Metadonnees').first().json.metadata : {};\nconst image_prompts = $input.first().json.image_prompts || [];\nconst inputs = $('Normaliser Inputs').first().json;\nconst meta = $('Parser Metadonnees').first().json.metadata || {};\nconst hero = image_prompts.find(p => (p.name||'').toLowerCase() === 'hero') || image_prompts[0] || {};\nconst alf_wordpress = {\n  title: meta.seo_title || inputs.sujet,\n  slug: meta.slug || '',\n  html,\n  excerpt: meta.excerpt || '',\n  categorie: inputs.categorie,\n  tags: meta.tags || [],\n  featured_image: hero.name || '',\n  featured_image_alt: (meta.alt_images && meta.alt_images[0]) || '',\n  meta_title: meta.seo_title || '',\n  meta_description: meta.meta_description || '',\n  canonical: meta.canonical || '',\n  robots: meta.robots || 'index, follow',\n  open_graph: { og_title: meta.og_title || '', og_description: meta.og_description || '' },\n  twitter_card: { twitter_title: meta.twitter_title || '', twitter_description: meta.twitter_description || '' },\n  json_ld: meta.json_ld_article || {},\n  faq_schema: meta.json_ld_faq || {},\n  article_schema: meta.json_ld_article || {},\n  reading_time: meta.reading_time || '',\n  auteur: 'IA - Workflow SEO',\n  date: new Date().toISOString(),\n  status: 'draft'\n};\nreturn [{ json: { alf_wordpress, html, metadata: meta, image_prompts } }];"
