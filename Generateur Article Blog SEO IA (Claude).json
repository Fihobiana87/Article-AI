    {
      "parameters": {
        "jsCode": "const ctx = $input.first().json;\nconst inputs = $('Normaliser Inputs').first().json;\nconst system = 'Tu es un expert SEO 2026 (EEAT, AEO, GEO, Semantic SEO, Topical Authority).';\nconst user = `Sujet: ${inputs.sujet}\\nMot-cle: ${inputs.mot_cle}\\nLangue: ${inputs.langue}\\nPays: ${inputs.pays}\\n\\n`+\n  `Donnees concurrents: ${JSON.stringify(ctx.concurrents).slice(0,8000)}\\n`+\n  `Donnees mots-cles: ${JSON.stringify(ctx.keywords_data)}\\n`+\n  `Donnees Search Console: ${JSON.stringify(ctx.gsc_data)}\\n\\n`+\n  'Construis une strategie editoriale complete au format JSON strict avec les cles: '+\n  'intention_principale, sous_intentions, entites, sujets_connexes, plan_hn (H1/H2/H3), '+\n  'questions_faq, mots_cles_secondaires. Reponds uniquement en JSON valide, sans texte autour.';\nreturn [{ json: { system, user_prompt: user, model: inputs.claude_model_strategie } }];"
      },
