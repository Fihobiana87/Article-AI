      "parameters": {
        "jsCode": "const strategie = $input.first().json.strategie;\nconst inputs = $('Normaliser Inputs').first().json;\nconst system = 'Tu es un redacteur SEO senior. Tu ecris uniquement a partir des donnees fournies, sans invention.';\nconst user = `Redige un article HTML complet (H1, H2, H3, paragraphes, listes, tableaux si utiles, `+\n  `citations, FAQ, CTA, suggestions de liens internes/externes) en ${inputs.langue}, `+\n  `sur le sujet '${inputs.sujet}' (mot-cle: ${inputs.mot_cle}).\\n\\n`+\n  `Strategie a suivre: ${JSON.stringify(strategie)}\\n\\n`+\n  'Reponds uniquement avec le HTML de l\\'article, sans balises <html> ou <body>, sans commentaire.';\nreturn [{ json: { system, user_prompt: user, model: inputs.claude_model } }];"
